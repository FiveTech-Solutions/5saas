# Exemplo de arquivo de variáveis de ambiente
# Copie este arquivo para .env.local e preencha com suas credenciais

# API Base URL (Sandbox - para produção, altere para a URL de produção)
VITE_API_BASE_URL=https://api.sandbox.plugnotas.com.br

# Chave de API da Technospeed (PlugNotas)
# Também pode ser configurada pela interface em Configurações
# VITE_API_KEY=sua_chave_aqui
